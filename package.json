    "product:github-pr-import": "node dist/apps/cli/src/product-github-pr-import.js",
    "product:github-pr-pilot": "node dist/apps/cli/src/product-real-pr-pilot.js --input examples/product-runtime/real-pr-fixtures/nanoid-github-prs.draft.json",
    "product:p-limit-pr-import": "node dist/apps/cli/src/product-github-pr-import.js --repo sindresorhus/p-limit --policy p-limit --prs 98,93,88,83,79,71,50,47,35,30,28,20 --out examples/product-runtime/real-pr-fixtures/p-limit-github-prs.draft.json",
    "product:p-limit-pr-pilot": "node dist/apps/cli/src/product-real-pr-pilot.js --input examples/product-runtime/real-pr-fixtures/p-limit-github-prs.draft.json",
    "product:pr-calibration": "node dist/apps/cli/src/product-pr-calibration.js",
    "product:pr-reviewed-calibration": "node dist/apps/cli/src/product-pr-calibration.js --overrides examples/product-runtime/real-pr-fixtures/nanoid-reviewed-label-overrides.json",
    "product:pr-label-comparison": "node dist/apps/cli/src/product-pr-label-comparison.js",
    "product:p-limit-reviewed-calibration": "node dist/apps/cli/src/product-pr-calibration.js --input examples/product-runtime/real-pr-fixtures/p-limit-github-prs.draft.json --overrides examples/product-runtime/real-pr-fixtures/p-limit-reviewed-label-overrides.json",
    "product:p-limit-label-comparison": "node dist/apps/cli/src/product-pr-label-comparison.js --input examples/product-runtime/real-pr-fixtures/p-limit-github-prs.draft.json --overrides examples/product-runtime/real-pr-fixtures/p-limit-reviewed-label-overrides.json",
    "product:cross-repo-validation": "node dist/apps/cli/src/product-cross-repo-validation.js",
    "product:mixed-external-validation": "node dist/apps/cli/src/product-mixed-external-validation.js",
    "product:pilot-insights": "node dist/apps/cli/src/product-pilot-insights.js",
    "product:report-index": "node dist/apps/cli/src/product-report-index.js",
    "product:team-metrics": "node dist/apps/cli/src/product-team-metrics.js",
    "product:artifact-viewer": "node dist/apps/cli/src/product-artifact-viewer.js",
    "product:demo-package": "node dist/apps/cli/src/product-demo-package.js",
    "product:dogfood-validation": "node dist/apps/cli/src/product-dogfood-validation.js",
    "product:external-evidence": "node dist/apps/cli/src/product-external-evidence.js",
    "product:pilot-manifest": "node dist/apps/cli/src/product-pilot-manifest.js",
    "product:provider-live-test": "node dist/apps/cli/src/product-provider-live-test.js",
    "product:consumer-smoke-kit": "node dist/apps/cli/src/product-consumer-smoke-kit.js",
    "oss:prepare": "node dist/apps/cli/src/prepare-oss-repo.js",
    "code:benchmark": "node dist/apps/cli/src/code-patch-benchmark.js",
    "code:model-benchmark": "node dist/apps/cli/src/code-model-patch-benchmark.js",
    "code:model-rag-benchmark": "CODE_CONTEXT_STRATEGY=rag node dist/apps/cli/src/code-model-patch-benchmark.js",
    "code:model-expanded-benchmark": "CODE_CONTEXT_STRATEGY=expanded node dist/apps/cli/src/code-model-patch-benchmark.js",
    "code:model-synthetic-benchmark": "CODE_CONTEXT_STRATEGY=synthetic node dist/apps/cli/src/code-model-patch-benchmark.js",
    "code:model-workspace-benchmark": "CODE_AGENT_FLOW=workspace node dist/apps/cli/src/code-model-patch-benchmark.js",
    "code:model-workspace-verifier-benchmark": "CODE_AGENT_FLOW=workspace_verifier node dist/apps/cli/src/code-model-patch-benchmark.js",
    "code:model-workspace-verifier-remask-benchmark": "CODE_AGENT_FLOW=workspace_verifier_remask node dist/apps/cli/src/code-model-patch-benchmark.js",
    "code:model-remask-verifier-benchmark": "CODE_MODEL_CASE_SUITE=remask_required CODE_AGENT_FLOW=workspace_verifier node dist/apps/cli/src/code-model-patch-benchmark.js",
    "code:model-remask-verifier-remask-benchmark": "CODE_MODEL_CASE_SUITE=remask_required CODE_AGENT_FLOW=workspace_verifier_remask node dist/apps/cli/src/code-model-patch-benchmark.js",
    "code:dllm-benchmark": "node dist/apps/cli/src/code-dllm-patch-benchmark.js",
    "code:failure-taxonomy": "node dist/apps/cli/src/code-failure-taxonomy.js",
    "ablation:run": "node dist/apps/cli/src/ablation-run.js",
    "hard:benchmark": "node dist/apps/cli/src/ablation-run.js --suite hard --modes bounded_refinement",
    "hard:ablation": "node dist/apps/cli/src/ablation-run.js --suite hard",
    "remask:benchmark": "node dist/apps/cli/src/remask-benchmark.js",
    "worker:dry-run": "node dist/apps/cli/src/worker-dry-run.js",
    "worker:mini-benchmark": "node dist/apps/cli/src/worker-mini-benchmark.js",
    "worker:full-benchmark": "node dist/apps/cli/src/worker-full-benchmark.js",
    "worker:hard-benchmark": "node dist/apps/cli/src/worker-hard-benchmark.js",
    "worker:llm-hard-benchmark": "node dist/apps/cli/src/worker-llm-context-benchmark.js",
    "worker:llm-rag-hard-benchmark": "LLM_CONTEXT_STRATEGY=rag node dist/apps/cli/src/worker-llm-context-benchmark.js",
    "worker:llm-expanded-hard-benchmark": "LLM_CONTEXT_STRATEGY=expanded node dist/apps/cli/src/worker-llm-context-benchmark.js",
    "worker:llm-synthetic-hard-benchmark": "LLM_CONTEXT_STRATEGY=synthetic node dist/apps/cli/src/worker-llm-context-benchmark.js",
    "worker:smoke": "node dist/apps/cli/src/worker-smoke.js",
    "worker:dream": "python3 apps/dllm-worker/dream_worker.py",
    "worker:llm-openai": "node dist/apps/llm-worker/openai_compatible_worker.js",
    "worker:http-health-smoke": "node dist/apps/cli/src/worker-http-health-smoke.js",
    "worker:http-refine-smoke": "node dist/apps/cli/src/worker-http-refine-smoke.js",
    "worker:http-mock-contract-smoke": "node dist/apps/cli/src/worker-http-mock-contract-smoke.js",
    "worker:orchestrator-smoke": "node dist/apps/cli/src/worker-backed-orchestrator-smoke.js",
    "runtime:verify": "npm run typecheck && npm run build && node dist/apps/cli/src/runtime-verify.js",
    "model:adapter-smoke": "node dist/apps/cli/src/model-adapter-smoke.js",
    "model:worker-smoke": "node dist/apps/cli/src/model-worker-smoke.js",
    "oracle:audit": "node dist/apps/cli/src/oracle-audit.js",
    "repo:intelligence-smoke": "node dist/apps/cli/src/repo-intelligence-smoke.js",
    "repo:context-smoke": "node dist/apps/cli/src/repo-context-composer-smoke.js",
    "repo:context-report": "node dist/apps/cli/src/repo-context-composer-report.js",
    "repo:changed-context-report": "node dist/apps/cli/src/repo-changed-context-report.js",
    "repo:orchestrator-smoke": "node dist/apps/cli/src/repo-orchestrator-smoke.js",
    "repo:orchestrator-report": "node dist/apps/cli/src/repo-orchestrator-report.js",
    "repo:changed-files-smoke": "node dist/apps/cli/src/repo-changed-files-smoke.js",
    "repo:evaluation-verify": "npm run typecheck && npm run build && node dist/apps/cli/src/real-repo-verify.js && node dist/apps/cli/src/baseline-strategy-contract-smoke.js && node dist/apps/cli/src/baseline-strategy-report.js && node dist/apps/cli/src/baseline-comparison-report.js",
    "cost:benchmark": "node dist/apps/cli/src/cost-benchmark.js",
    "merge:smoke": "node dist/apps/cli/src/conflict-aware-merge-smoke.js",
    "merge:report": "node dist/apps/cli/src/conflict-aware-merge-report.js",
    "orchestrator:smoke": "node dist/apps/cli/src/orchestrator-smoke.js",
    "orchestrator:report": "node dist/apps/cli/src/orchestrator-report.js",
    "context:composer-smoke": "node dist/apps/cli/src/context-composer-smoke.js",
    "context:composer-report": "node dist/apps/cli/src/context-composer-report.js",
    "remask:repair-smoke": "node dist/apps/cli/src/remask-repair-smoke.js",
    "remask:repair-report": "node dist/apps/cli/src/remask-repair-report.js",
    "remask:repair-safety-smoke": "node dist/apps/cli/src/remask-repair-safety-smoke.js",
    "remask:repair-safety-report": "node dist/apps/cli/src/remask-repair-safety-report.js",
    "real:diff-smoke": "node dist/apps/cli/src/real-repo-diff-smoke.js",
    "real:evaluation-report": "node dist/apps/cli/src/real-repo-evaluation-report.js",
    "real:control-report": "GIT_DIFF_FILE=examples/real-repo-evaluation/empty.diff GIT_DIFF_INCLUDE_UNTRACKED=0 node dist/apps/cli/src/real-repo-control-report.js",
    "clean": "rm -rf dist",
    "pr:changed-files-smoke": "node dist/apps/cli/src/pr-changed-files-smoke.js",
    "pr:evaluation-report": "node dist/apps/cli/src/pr-evaluation-report.js",
    "real:safety-regression": "GIT_DIFF_FILE=examples/real-repo-evaluation/empty.diff GIT_DIFF_INCLUDE_UNTRACKED=0 node dist/apps/cli/src/real-repo-safety-regression-report.js",
    "real:verify": "npm run typecheck && npm run build && node dist/apps/cli/src/real-repo-verify.js",
    "baseline:comparison-report": "node dist/apps/cli/src/baseline-comparison-report.js",
    "baseline:verify": "npm run typecheck && npm run build && npm run baseline:strategy-contract-smoke && npm run baseline:strategy-report && npm run baseline:comparison-report",
    "baseline:strategy-contract-smoke": "node dist/apps/cli/src/baseline-strategy-contract-smoke.js",
    "baseline:strategy-report": "node dist/apps/cli/src/baseline-strategy-report.js",
    "verify:evaluation-pipeline": "npm run repo:evaluation-verify && npm run report:model-acceptance && npm run fetch:github-pr",
    "verify:dllm-verifier": "npm run typecheck && npm run build && npm run smoke:dllm-verifier && npm run smoke:dllm-verifier:pipeline && npm run report:dllm-verifier",
    "smoke:dllm-verifier": "node dist/apps/cli/src/dllm-verifier-smoke.js",
    "report:model-acceptance": "node dist/apps/cli/src/model-worker-acceptance-report.js",
    "fetch:github-pr": "node dist/apps/cli/src/github-pr-live-fetch.js",
    "smoke:dllm-verifier:pipeline": "node dist/apps/cli/src/dllm-verifier-pipeline-smoke.js",
    "verify:all": "npm run verify:evaluation-pipeline && npm run verify:dllm-verifier",
    "report:dllm-verifier": "node dist/apps/cli/src/dllm-verifier-report.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.6.3"
  }
}

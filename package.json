{
  "name": "bounded-dllm-agent-lab",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Open-source research lab for bounded-context dLLM agents, synthetic context enrichment, and shared semantic workspaces.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test:smoke": "node dist/tests/smoke/contracts.js",
    "eval:demo": "node dist/apps/cli/src/index.js",
    "reports:compare": "node dist/apps/cli/src/compare-reports.js",
    "reports:llm-context": "node dist/apps/cli/src/llm-context-comparison.js",
    "reports:research-figures": "node dist/apps/cli/src/research-figures.js",
    "reports:code-hybrid": "node dist/apps/cli/src/code-hybrid-comparison.js",
    "reports:code-remask": "node dist/apps/cli/src/code-remask-comparison.js",
    "product:review": "node dist/apps/cli/src/product-review.js",
    "product:comment": "node dist/apps/cli/src/product-comment.js",
    "product:policy": "node dist/apps/cli/src/product-policy.js",
    "product:action-smoke": "node dist/apps/cli/src/product-action-smoke.js",
    "product:pilot": "node dist/apps/cli/src/product-pilot.js",
    "product:pilot-v2": "node dist/apps/cli/src/product-pilot-v2.js",

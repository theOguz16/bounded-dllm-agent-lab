# Bounded dLLM Agent Lab environment example
# Copy this file to .env when you want to run local or live model experiments.
#
# The default repository checks do not require live model endpoints.
# Live model variables are only needed for RunPod / local inference / model-worker tests.

# -------------------------------------------------------------------
# Live model worker endpoints
# -------------------------------------------------------------------
# OpenAI-compatible chat completion endpoint for the autoregressive LLM slot.
# Example: llama.cpp Qwen endpoint.
LLM_UPSTREAM_URL=http://127.0.0.1:8000/v1/chat/completions

# OpenAI-compatible chat completion endpoint for the dLLM / verifier slot.
# Example: Dream-Coder OpenAI-compatible local server.
DLLM_UPSTREAM_URL=http://127.0.0.1:8002/v1/chat/completions

# Alternative worker URLs used by older acceptance paths.
# Usually you can leave these empty when using LLM_UPSTREAM_URL and DLLM_UPSTREAM_URL.
LLM_WORKER_URL=
DLLM_WORKER_URL=

# -------------------------------------------------------------------
# Live model IDs
# -------------------------------------------------------------------
LLM_MODEL_ID=qwen2.5-coder-7b
DLLM_MODEL_ID=dream-coder-v0-instruct-7b

# -------------------------------------------------------------------
# Optional auth
# -------------------------------------------------------------------
# Only set these if your upstream endpoints require bearer tokens.
MODEL_WORKER_API_KEY=
LLM_UPSTREAM_API_KEY=
DLLM_UPSTREAM_API_KEY=
RUNPOD_API_KEY=

# -------------------------------------------------------------------
# RunPod / model worker proxy controls
# -------------------------------------------------------------------
# Set to 1 when a live RunPod model-worker acceptance run must fail if workers are missing or failing.
RUNPOD_LIVE_REQUIRED=0

# Set to 1 when real model acceptance should be required instead of skipped.
MODEL_ACCEPTANCE_REQUIRED=0

# Increase this for slow local models or diffusion-style generation.
MODEL_WORKER_PROXY_TIMEOUT_MS=300000

# -------------------------------------------------------------------
# Live mini benchmark controls
# -------------------------------------------------------------------
# The live mini benchmark compares the LLM and dLLM slots on bounded-agent risk cases.
#
# If LIVE_MINI_BENCHMARK_REQUIRED=0 and endpoints are missing, the benchmark writes a skipped report.
# If LIVE_MINI_BENCHMARK_REQUIRED=1 and endpoints are missing/failing, the command fails.
LIVE_MINI_BENCHMARK_REQUIRED=0

# Strict mode fails when expected-vs-actual scoring does not pass.
# Keep this 0 for exploratory runs. Use 1 for gated validation.
LIVE_MINI_BENCHMARK_STRICT=0

# Request timeout per model call.
LIVE_MINI_BENCHMARK_TIMEOUT_MS=300000

# Maximum generated tokens per case.
LIVE_MINI_BENCHMARK_MAX_TOKENS=128

# Output preview length stored in reports.
LIVE_MINI_BENCHMARK_PREVIEW_CHARS=700

# Output directory for JSON and Markdown benchmark reports.
LIVE_MINI_BENCHMARK_OUT_DIR=reports/live-mini-benchmark

# -------------------------------------------------------------------
# Optional sampling controls
# -------------------------------------------------------------------
LLM_TEMPERATURE=0
DLLM_TEMPERATURE=0.2
